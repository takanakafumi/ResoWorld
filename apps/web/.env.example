# Local extraction is the default. Ollama is restricted to a loopback URL.
RESOWORLD_EXTRACTION_PROVIDER=ollama
RESOWORLD_OLLAMA_BASE_URL=http://127.0.0.1:11434
RESOWORLD_OLLAMA_MODEL=qwen3.5:9b

# Optional external provider. Server-only; never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
RESOWORLD_OPENAI_WEB_SEARCH_ENABLED=false
RESOWORLD_OPENAI_WEB_SEARCH_MODEL=gpt-5.4-nano

# Absolute path to private local imports. Keep the actual path in .env.local.
RESOWORLD_LOCAL_IMPORT_ENABLED=false
RESOWORLD_IMPORT_DIR=

# Local-only Evidence Graph review dataset.
RESOWORLD_REVIEW_ENABLED=false
RESOWORLD_REVIEW_DIR=
RESOWORLD_REVIEW_FILE=
RESOWORLD_REVIEW_ATLAS_FILE=
RESOWORLD_REVIEW_INITIAL_STATUS=

# Optional local Codex CLI wrapper. Uses existing Codex authentication, not OPENAI_API_KEY.
RESOWORLD_CODEX_CLI_ENABLED=false
RESOWORLD_CODEX_CLI_PATH=codex
RESOWORLD_CODEX_CLI_TIMEOUT_MS=180000
