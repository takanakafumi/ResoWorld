# Local extraction is the default. Ollama is restricted to a loopback URL.
RESOWORLD_EXTRACTION_PROVIDER=ollama
RESOWORLD_OLLAMA_BASE_URL=http://127.0.0.1:11434
RESOWORLD_OLLAMA_MODEL=qwen3.5:9b

# Optional external provider. Server-only; never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Absolute path to private local imports. Keep the actual path in .env.local.
RESOWORLD_LOCAL_IMPORT_ENABLED=false
RESOWORLD_IMPORT_DIR=
